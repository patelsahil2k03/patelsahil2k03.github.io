# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
private/
trash/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
# Project skills under .cursor/skills/ are tracked (one home for every harness); only the vendored UI skill and personal settings stay local
.cursor/skills/ui-ux-pro-max/
.cursor/sandbox.json
.claude/settings.local.json
# Word resumes carry the employer's template and personal contact data: local only (docs/private/ holds working notes)
/Resume_FullStack.docx
resume/*.docx
# GCP service-account keys never enter this public repository (the owner keeps them outside it).
sahil-test-*.json
*service-account*.json
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
/build/
/.cache/

# Logs
logs
*.log

# Temporary files
/tmp/
*.tmp
file_list.txt
output.txt

# Trash folder
.trash/

# Python bytecode from tools/ (checks, agent guard)
__pycache__/
*.py[cod]

# Optional: Keep old components for reference but don't track changes
# /src/comps/
